rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Todas las cuentas del proyecto (una por persona) comparten el laboratorio. Solo existen las
    // que se crean en la consola de Firebase: la creación de cuentas desde fuera está desactivada.
    match /laboratorios/{laboratorio}/{documento=**} {
      allow read, write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
  }
}
